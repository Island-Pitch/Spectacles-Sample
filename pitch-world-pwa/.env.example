# Pitch World PWA — Environment Variables
# Copy to .env.local and fill in your keys

# API Gateway endpoint (deployed via SAM)
NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/prod

# Client-side feature flags
NEXT_PUBLIC_ENABLE_WEBXR=true
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_DEFAULT_3D_PROVIDER=meshy

# These keys are ONLY used in Lambda functions (never exposed to client)
# Set them in your SAM template parameters or AWS Secrets Manager
# MESHY_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
